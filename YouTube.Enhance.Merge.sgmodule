name: YouTube 增强（IBL3ND + Maasea 合并版）
description: 去广告/自动最高画质/后台播放/画中画 + 字幕翻译/UI精简。以原版 Egern-YouTube.yaml 为底，脚本本地化至本仓库。
compat_arguments:
  blockUpload: 'true'
  blockShorts: 'true'
  autoHd: 'true'
  blockGames: 'true'
  blockVerticalLive: 'true'
  jumpAhead: 'true'
  blockStore: 'true'
  nativeDownload: 'true'
  captionLang: 'true'
  blockImmersive: 'true'
  debug: 'false'
  blockUpload: 'true'
  blockShorts: 'false'
compat_arguments_schema:
  blockUpload:
    name: 隐藏「上传」入口
    description: 隐藏导航栏中的「上传」入口
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  blockShorts:
    name: 隐藏「Shorts」入口
    description: 隐藏导航栏中的「Shorts」入口
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  autoHd:
    name: 自动最高画质
    description: 优先使用最高可用画质，并阻止自动降低画质
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  blockGames:
    name: 隐藏小游戏推荐
    description: 隐藏 YouTube Playables（小游戏）推荐
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  blockVerticalLive:
    name: 隐藏竖屏直播推荐
    description: 隐藏各界面中的竖屏直播推荐
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  jumpAhead:
    name: 启用 Jump Ahead
    description: 启用原生「Jump Ahead」跳转按钮，并去除其推广提示
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  blockStore:
    name: 隐藏商店和购物板块
    description: 隐藏视频下方和频道主页中的创作者商店、购物板块
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  nativeDownload:
    name: 原生下载（实验性）
    description: 实验性原生下载功能；未设置画质时使用 720p，服务器限制可能仍然生效
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  captionLang:
    name: 字幕翻译为简体中文
    description: 开启后自动将字幕翻译为简体中文（对应 zh-Hans），关闭则不翻译
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  blockImmersive:
    name: 隐藏「选段」按钮
    description: 隐藏沉浸式/选段按钮
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  debug:
    name: 启用调试模式
    description: 输出更多日志用于排查问题
    default_value: 'false'
    options:
    - 'true'
    - 'false'
  blockUpload:
    name: 隐藏「上传」入口（Maasea）
    description: 隐藏导航栏中的「上传」入口
    default_value: 'true'
    options:
    - 'true'
    - 'false'
  blockShorts:
    name: 隐藏「Shorts」入口（Maasea）
    description: 隐藏导航栏中的「Shorts」入口
    default_value: 'false'
    options:
    - 'true'
    - 'false'
author: gholts & Maasea（合并整理：SIJULY）
homepage: https://github.com/gholts/surge/tree/main/modules
icon: https://iili.io/KQ67Yxa.png
dns: {}
rewrites:
- match: ^https:\/\/www\.youtube\.com\/(pagead|pcs)\/
  actions:
  - respond:
      status: 404
- match: ^https:\/\/s\.youtube\.com\/api\/stats\/ads
  actions:
  - respond:
      status: 404
scriptings:
- http_request:
    name: youtube.enhance.ad-break
    match: ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$
    script_url: https://raw.githubusercontent.com/SIJULY/surge/refs/heads/main/Script/Youtube/ibl3nd.request.js
- http_response:
    name: youtube.enhance.download
    match: ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$
    script_url: https://raw.githubusercontent.com/SIJULY/surge/refs/heads/main/Script/Youtube/ibl3nd.response.js
    env:
      _compat.$argument: '{"nativeDownload":{{{nativeDownload}}}}'
    max_size: 0
    body_required: true
    binary_body: true
- http_request:
    name: youtube.enhance.download-player
    match: ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$
    script_url: https://raw.githubusercontent.com/SIJULY/surge/refs/heads/main/Script/Youtube/ibl3nd.request.js
    env:
      _compat.$argument: '{"nativeDownload":{{{nativeDownload}}}}'
    max_size: 0
    body_required: true
    binary_body: true
- http_response:
    name: youtube.enhance.response
    match: ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$
    script_url: https://raw.githubusercontent.com/SIJULY/surge/refs/heads/main/Script/Youtube/ibl3nd.response.js
    env:
      _compat.$argument: '{"blockUpload":{{{blockUpload}}},"blockShorts":{{{blockShorts}}},"blockGames":{{{blockGames}}},"blockVerticalLive":{{{blockVerticalLive}}},"jumpAhead":{{{jumpAhead}}},"autoHd":{{{autoHd}}},"blockStore":{{{blockStore}}}}'
    max_size: 0
    body_required: true
    binary_body: true
- http_response:
    name: youtube.enhance.ump
    match: ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$
    script_url: https://raw.githubusercontent.com/SIJULY/surge/refs/heads/main/Script/Youtube/ibl3nd.response.js
    env:
      _compat.$argument: '{"blockGames":{{{blockGames}}},"blockVerticalLive":{{{blockVerticalLive}}},"jumpAhead":{{{jumpAhead}}},"autoHd":{{{autoHd}}},"blockStore":{{{blockStore}}}}'
    max_size: 0
    body_required: true
    binary_body: true
- http_request:
    name: youtube.enhance.init
    match: ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$
    script_url: https://raw.githubusercontent.com/SIJULY/surge/refs/heads/main/Script/Youtube/ibl3nd.request.js
    max_size: 0
    body_required: true
    binary_body: true
- http_request:
    name: youtube.enhance.auto-hd
    match: ^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback
    script_url: https://raw.githubusercontent.com/SIJULY/surge/refs/heads/main/Script/Youtube/ibl3nd.request.js
    env:
      _compat.$argument: '{"autoHd":{{{autoHd}}}}'
    max_size: 0
    body_required: true
    binary_body: true
- http_request:
    name: youtube.enhance.log-event
    match: ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event
    script_url: https://raw.githubusercontent.com/SIJULY/surge/refs/heads/main/Script/Youtube/ibl3nd.request.js
    max_size: 0
    body_required: true
    binary_body: true
- http_response:
    name: youtube.enhance.maasea-response
    match: ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.*)?$
    script_url: https://raw.githubusercontent.com/SIJULY/surge/refs/heads/main/Script/Youtube/maasea.response.js
    env:
      _compat.$argument: '{"captionLang":"{{{captionLang}}}","blockUpload":{{{blockUpload}}},"blockImmersive":{{{blockImmersive}}},"blockShorts":{{{blockShorts}}},"debug":{{{debug}}}}'
    max_size: 0
    body_required: true
    binary_body: true
- http_request:
    name: youtube.enhance.maasea-log-event
    match: ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event
    script_url: https://raw.githubusercontent.com/SIJULY/surge/refs/heads/main/Script/Youtube/maasea.request.js
    env:
      _compat.$argument: '{"captionLang":"{{{captionLang}}}","blockUpload":{{{blockUpload}}},"blockImmersive":{{{blockImmersive}}},"blockShorts":{{{blockShorts}}},"debug":{{{debug}}}}'
    max_size: 0
    body_required: true
    binary_body: true
mitm:
  hostnames:
    includes:
    - '*.googlevideo.com'
    - youtubei.googleapis.com
    - www.youtube.com
    - s.youtube.com
